# Installed packages -- anyone can rebuild these with "npm install",
# and they're 59MB, so they don't belong in the repo.
node_modules/

# Build output
dist/
dist-ssr/

# Logs
*.log
npm-debug.log*

# Editor and OS junk
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Screenshots you take with P are personal -- keep the folder and its
# README, but don't commit every PNG. Delete this line if you WANT to
# store your promo shots in the repo.
screenshots/*.png
dist
.vercel
